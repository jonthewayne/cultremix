{
  "name": "cultremix",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "@babel/core": "7.29.7",
    "baseline-browser-mapping": "2.11.26",
    "browserslist": "4.29.2",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "nanoid@^3": "3.3.19",
    "postcss": "8.5.28",
    "undici": "7.30.0"
  },
  "scripts": {
    "dev": "convex dev --start 'bun run dev:web'",
    "dev:web": "vite dev",
    "dev:convex": "convex dev",
    "format": "prettier --write .",
    "lint": "tsc && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs vite build && tsc --noEmit",
    "start": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev",
    "typecheck": "tsc --noEmit && bun run scripts/convex-typecheck.ts",
    "test": "vitest run && vitest run --config vitest.convex-local.config.ts",
    "test:convex:local": "vitest run --config vitest.convex-local.config.ts",
    "test:watch": "vitest",
    "test:convex": "vitest run tests/convex --config vitest.convex.config.ts",
    "test:e2e": "bash tests/e2e/run-e2e.sh",
    "test:e2e:signed-in": "bash tests/e2e/run-signed-in.sh",
    "test:e2e:publish": "bash tests/e2e/run-publish.sh",
    "test:a11y": "bash tests/e2e/run-a11y.sh",
    "test:image": "bun tests/image-e2e/run.ts",
    "test:chain:anvil": "vitest run --config vitest.chain-e2e.config.ts",
    "chain:deploy:testnet": "bun run scripts/chain/deploy-testnet.ts",
    "chain:deploy:mainnet": "bun run scripts/chain/deploy-testnet.ts --env prod",
    "chain:verify:testnet": "bun run scripts/chain/verify-registry.ts",
    "chain:verify:mainnet": "bun run scripts/chain/verify-registry.ts --env prod",
    "circle:setup": "bun run scripts/circle-setup.ts",
    "setup": "bun run scripts/setup.ts",
    "new-project": "bun run scripts/create-project.ts",
    "doctor": "bun run scripts/doctor.ts",
    "seed:environment": "bun run scripts/seed-environment.ts",
    "judges:provision": "bun run scripts/provision-judges.ts",
    "doctor:external": "bun run scripts/doctor.ts --external",
    "doctor:deployment": "bun run scripts/doctor.ts --deployment --external",
    "cf-typegen": "WRANGLER_LOG_PATH=.wrangler/logs CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
    "preview:cf": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev",
    "deploy:dev": "CLOUDFLARE_ENV=development bun run build && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging WRANGLER_LOG_PATH=.wrangler/logs vite build --mode staging && tsc --noEmit && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production bun run build && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "deploy:migrate": "bun run scripts/deploy-migrate.ts",
    "launch:batches": "bun run scripts/launch-batches.ts",
    "postinstall": "bun run cf-typegen || true"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.100",
    "@aws-sdk/client-s3": "3.1143.0",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/resend": "^0.2.8",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "^1.168.59",
    "@vitejs/plugin-react": "^5.2.0",
    "ai": "^7.0.122",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "fast-png": "^8.0.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "telnyx": "^7.24.0",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/eslint-config": "^0.3.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "convex-test": "^0.0.60",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  }
}
