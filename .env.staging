# Staging build values (non-secret), read by `bun run deploy:staging` (vite --mode staging).
# Replace with the staging Convex deployment's URLs before the first deploy.
VITE_CONVEX_URL=https://REPLACE_WITH_STAGING_DEPLOYMENT.convex.cloud
VITE_CONVEX_SITE_URL=https://REPLACE_WITH_STAGING_DEPLOYMENT.convex.site
VITE_DEPLOYMENT_ENV=staging
