{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cultremix",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "ENVIRONMENT": "preview",
    "SITE_URL": "https://mighteous.tailb6e2ea.ts.net:3000",
    "VITE_CONVEX_URL": "https://vibrant-rook-798.convex.cloud",
    "VITE_CONVEX_SITE_URL": "https://vibrant-rook-798.convex.site"
  },
  "env": {
    "production": {
      "name": "cultremix-prod",
      "workers_dev": true,
      "routes": [
        { "pattern": "cultremix.com", "custom_domain": true },
        { "pattern": "www.cultremix.com", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://cultremix.com",
        // The live Shopify store; its Storefront token is the Worker secret SHOPIFY_STOREFRONT_PRIVATE_TOKEN.
        "SHOPIFY_SHOP_DOMAIN": "ksbu5d-ax.myshopify.com",
        "VITE_CONVEX_URL": "https://savory-tiger-504.convex.cloud",
        "VITE_CONVEX_SITE_URL": "https://savory-tiger-504.convex.site"
      }
    },
    // Hackathon staging (Monad testnet). Replace the two Convex URLs with the staging
    // deployment's before the first deploy; docs/launch-checklist.md has the steps.
    "staging": {
      "name": "cultremix-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "staging.cultremix.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://staging.cultremix.com",
        "VITE_CONVEX_URL": "https://REPLACE_WITH_STAGING_DEPLOYMENT.convex.cloud",
        "VITE_CONVEX_SITE_URL": "https://REPLACE_WITH_STAGING_DEPLOYMENT.convex.site"
      }
    },
    "development": {
      "name": "cultremix-dev",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "development",
        "SITE_URL": "https://cultremix-dev.REPLACE_WITH_WORKERS_SUBDOMAIN.workers.dev",
        "VITE_CONVEX_URL": "https://vibrant-rook-798.convex.cloud",
        "VITE_CONVEX_SITE_URL": "https://vibrant-rook-798.convex.site"
      }
    }
  }
}
